{
  "name": "liime-words",
  "private": true,
  "version": "1.0.0",
  "description": "Liime Words Dedicated to Studio Writers by LIIME",
  "type": "module",
  "main": "electron/main.cjs",
  "author": "LIIME",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "dev:server": "tsx server.ts",
    "postinstall": "node scripts/patch-electron-builder.js && node scripts/generate-liime-logo.js",
    "prebuild": "node scripts/patch-electron-builder.js && node scripts/generate-liime-logo.js",
    "build": "vite build",
    "build:web": "vite build",
    "pages:build": "vite build",
    "preview": "vite preview",
    "start": "tsx server.ts",
    "clean": "rm -rf dist release",
    "lint": "tsc --noEmit",
    "electron": "node scripts/launch-electron.cjs",
    "electron:dev": "concurrently -k -s first \"npm run dev\" \"wait-on -t 30000 tcp:3000 && cross-env VITE_DEV_SERVER_URL=http://localhost:3000 node scripts/launch-electron.cjs\"",
    "dist": "npm run build && electron-builder --win --x64",
    "dist:win": "npm run build && electron-builder --win --x64",
    "pack": "npm run build && electron-builder --dir"
  },
  "build": {
    "appId": "com.liime.words",
    "productName": "Liime Words",
    "copyright": "Copyright © 2026 LIIME",
    "compression": "store",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/**/*"
    ],
    "asar": true,
    "extraMetadata": {
      "main": "electron/main.cjs"
    },
    "win": {
      "signExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "${productName} Setup ${version}.${ext}",
      "fileAssociations": [
        {
          "ext": "liw",
          "name": "Liime Words Project",
          "description": "Liime Words Dedicated Studio Writer Project File",
          "icon": "build/icon.ico",
          "role": "Editor"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Liime Words",
      "uninstallDisplayName": "Liime Words by LIIME",
      "installerIcon": "build/installerIcon.ico",
      "uninstallerIcon": "build/uninstallerIcon.ico",
      "installerHeader": "build/installerHeader.bmp",
      "installerHeaderIcon": "build/installerHeaderIcon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    }
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^13.0.0",
    "firebase-admin": "^14.5.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite-plugin-pwa": "^1.3.0",
    "wait-on": "^9.5.1"
  }
}
